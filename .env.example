# Токен бота канала — из чата с @BotFather, целиком «цифры:буквы». Сам файл с секретами кладёт Егор.
TELEGRAM_BOT_TOKEN=<токен бота от @BotFather>
# Необязательно (Р59 — не заводим): токен GitHub только для чтения — нужен лишь для ручного выпуска с компьютера, чтобы поиск issue не упирался в 60 запросов в час. В облаке issue собирает GitHub Actions.
GITHUB_TOKEN=<токен GitHub только для чтения публичных репозиториев>
# Необязательно: ключ twitterapi.io — третий запасной путь X. Нет ключа — путь пропускается.
TWITTERAPI_KEY=
# Только на компьютере владельца, для push правок кода в основную ветку: закрытый ключ развёртывания «okno» одной строкой base64 файла ключа. В облаке и в GitHub его нет.
NEWSAI_OKNO_KLYUCH=<закрытый ключ развёртывания okno, base64 одной строкой>

